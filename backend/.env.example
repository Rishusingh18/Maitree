# Environment variables for MetroSafetyAPI backend
# Copy this file to .env and fill in appropriate values.

APP_NAME=MetroSafetyAPI
DEBUG=False
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# Simple API key for authentication (set a strong key in production)
API_KEY=

# Paths to model files (relative to project root)
CROSSING_MODEL_PATH=models/crossing_model.pt
GESTURE_MODEL_PATH=models/gesture_model.pt

# Number of worker threads for async inference
MAX_WORKERS=4
